{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "bun test ./packages/server ./features/local"
  },
  "coverageAnalysis": "off",
  "checkers": [],
  "plugins": [],
  "reporters": ["clear-text"],
  "mutate": [
    "packages/server/src/**/*.ts",
    "!**/*.test.ts",
    "!packages/server/src/main.ts",
    "!packages/server/src/status.ts",
    "!packages/server/src/environment.ts",
    "!packages/server/src/check3.ts",
    "!packages/server/src/check3-page.ts"
  ],
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "ignorePatterns": ["**/dist/**", ".devctl", "turn"],
  "cleanTempDir": "always",
  "timeoutMS": 60000,
  "concurrency": 4
}
